able" disabled={busy} onClick={release}><CheckCircle2 size={16}/>{busy==='release'?'Rilascio…':'Libera tavolo'}</button></>}<button disabled={busy||selected.status===SEATED} onClick={()=>setMoveMode(true)}><MoveRight size={16}/> Sposta tavolo</button><button disabled={busy} onClick={()=>navigate(`/booking/${encodeURIComponent(selected.id)}`)}><ExternalLink size={16}/> Apri prenotazione</button></div>:<div className="move-panel"><strong>Sposta {selected.name}</strong><span>Seleziona sala e nuovo tavolo o combinazione. Il backend del tenant verifica disponibilità, sala e conflitti prima del salvataggio.</span><select className="move-room-select" value={moveRoom||selected.room} onChange={e=>{setMoveRoom(e.target.value);setMoveSelection([])}}>{rooms.map(r=>{const name=roomName(r);return <option key={name} value={name}>{name}</option>})}</select><div className="move-tables">{allTables.filter(t=>t.room===(moveRoom||selected.room)).map(t=>{const id=String(t.id),chosen=moveSelection.includes(id),state=stateById.get(id),blocked=state?.current&&String(state.current.id)!==String(selected.id);return <button key={id} disabled={blocked} className={chosen?'chosen':''} onClick={()=>toggleMove(id)}><b>{t.label||tableLabel(id)}</b><small>{blocked?'Occupato':`${t.seats||'—'} posti`}</small></button>})}</div>{moveSelection.length>1&&<div className="combo-check"><Link2 size={13}/>{(board?.tableCombinations||[]).some(c=>c.room===(moveRoom||selected.room)&&canonicalTables(tableIds(c.tables))===canonicalTables(moveSelection))?'Combinazione configurata per questo tenant':'Combinazione non configurata per questo tenant'}</div>}<div className="move-actions"><button onClick={()=>setMoveMode(false)}>Annulla</button><button className="primary" disabled={!moveSelection.length||!moveComboAllowed||busy} onClick={move}>{busy==='move'?'Spostamento…':`Conferma ${canonicalTables(moveSelection)}`}</button></div></div>}
  </div></div>}
 </section>
}
function Kpi({label,value,danger}){return <article className={danger?'danger':''}><strong>{value}</strong><span>{label}</span></article>}
function LiveColumn({title,count,rows,now,cfg,onOpen}){return <article className="panel live-column"><div className="live-column-head"><strong>{title}</strong><span>{count}</span></div><div className="live-list">{rows.map(r=><button key={r.id} className={`live-row ${statusTone(r,now,cfg)}`} onClick={()=>onOpen(r)}><div className="live-row-time"><strong>{r.start}</strong><span>{statusLabel(r,now,cfg)}</span></div><div className="live-row-main"><strong>{r.name}</strong><span>{r.people} persone · {r.room||'Sala?'}</span></div><div className="live-row-table"><strong>{r.tables||'—'}</strong>{r.status===SEATED&&r.seatedAt&&<span>dalle {r.seatedAt}</span>}</div></button>)}{!rows.length&&<div className="empty live-empty">Nessuna prenotazione.</div>}</div></article>}
function LiveRoomMap({room,tables,stateById,geometry,combosByTable,query,onOpen}){const q=String(query||'').toLowerCase();return <article className="panel live-room-map"><div className="live-room-map-head"><div><span>Sala</span><h2>{room}</h2></div><div><strong>{tables.length}</strong><span>tavoli</span></div></div>{geometry.laidOut?<div className="live-spatial-floor">{tables.map(t=><SpatialTable key={t.id} table={t} state={stateById.get(String(t.id))} geometry={geometry} combos={combosByTable.get(String(t.id))||[]} query={q} onOpen={onOpen}/>)}</div>:<div className="live-fallback-floor">{tables.map(t=><SpatialTable key={t.id} table={t} state={stateById.get(String(t.id))} combos={combosByTable.get(String(t.id))||[]} query={q} onOpen={onOpen}/>)}</div>}</article>}
function SpatialTable({table,state,geometry,combos=[],query,onOpen}){const current=state?.current,next=state?.next,pressure=state?.pressure||{level:'free',label:'Libero',detail:`${table.seats||'—'} posti`},booking=current||next,match=!query||`${booking?.name||''} ${booking?.phone||''} ${booking?.tables||''} ${table.label||table.id}`.toLowerCase().includes(query),style=geometry?{left:`${(+table.x||0)/geometry.maxX*100}%`,top:`${(+table.y||0)/geometry.maxY*100}%`,width:`${Math.max(6,+table.width||10)/geometry.maxX*100}%`,height:`${Math.max(7,+table.height||10)/geometry.maxY*100}%`}:undefined;return <button style={style} className={`live-spatial-table ${pressure.level} ${booking&&tableIds(booking.tables).length>1?'joined':''} ${match?'':'dimmed'}`} onClick={()=>onOpen(booking)} disabled={!booking} title={pressure.detail}><div className="spatial-table-top"><strong>{table.label||tableLabel(table.id)}</strong>{combos.length>0&&<Link2 size={11}/>}</div><span>{pressure.label}</span>{booking?<small>{booking.name} · {booking.people} p</small>:<small>{table.seats||'—'} posti</small>}{booking&&tableIds(booking.tables).length>1&&<em>{booking.tables}</em>}</button>}

import React,{useCallback,useEffect,useMemo,useRef,useState}from'react'
import{Armchair,CheckCircle2,Clock3,RefreshCcw,Search,UsersRound,Utensils,Undo2,MoveRight,AlertTriangle,RadioTower,X,LayoutGrid,List,Link2,ExternalLink}from'lucide-react'
import{useNavigate}from'react-router-dom'
import{managerApi}from'../lib/api'
import{localToday}from'../lib/date'

const ACTIVE_EXCLUDED=new Set(['Cancellata','No-show'])
const SEATED='Accomodato'
const DEFAULT_LIVE={turnoverBufferMin:10,soonMin:30,lateMin:10}
function mins(t){const[a,b]=String(t||'00:00').split(':').map(Number);return(a||0)*60+(b||0)}
function tableIds(v){return String(v||'').split('+').map(x=>x.replace(/^T/i,'').trim()).filter(Boolean)}
function tableLabel(id){const s=String(id||'').trim();return /^T/i.test(s)?s:`T${s}`}
function canonicalTables(ids){return [...ids].map(x=>String(x).replace(/^T/i,'').trim()).filter(Boolean).sort((a,b)=>a.localeCompare(b,'it',{numeric:true})).map(tableLabel).join('+')}
function operationalMinute(serverTimestamp,receivedAt){const base=new Date(serverTimestamp||'');const d=Number.isNaN(base.getTime())?new Date():new Date(base.getTime()+Math.max(0,Date.now()-receivedAt));return d.getHours()*60+d.getMinutes()}
function operationalTime(serverTimestamp,receivedAt){const base=new Date(serverTimestamp||'');const d=Number.isNaN(base.getTime())?new Date():new Date(base.getTime()+Math.max(0,Date.now()-receivedAt));return d.toLocaleTimeString('it-IT',{hour:'2-digit',minute:'2-digit',hour12:false})}
function liveConfig(board,boot){const raw=board?.liveSettings||boot?.settings?.salaLive||{};return{turnoverBufferMin:Math.max(0,+raw.turnoverBufferMin||DEFAULT_LIVE.turnoverBufferMin),soonMin:Math.max(5,+raw.soonMin||DEFAULT_LIVE.soonMin),lateMin:Math.max(1,+raw.lateMin||DEFAULT_LIVE.lateMin)}}
function statusLabel(row,now,cfg){if(row.status===SEATED)return row.orderTaken?'Comanda presa':'Accomodato';const delta=now-mins(row.start);if(delta>=cfg.lateMin)return`In ritardo · ${delta} min`;if(delta>=0)return'In arrivo';if(delta>=-cfg.soonMin)return`Tra ${Math.abs(delta)} min`;return'Prenotato'}
function statusTone(row,now,cfg){if(row.status===SEATED)return row.orderTaken?'order':'seated';const delta=now-mins(row.start);if(delta>=cfg.lateMin)return'late';if(delta>=0)return'arriving';if(delta>=-cfg.soonMin)return'soon';return'future'}
function tablePressure(state,now,cfg){const{current,next}=state;if(!current&&!next)return{level:'free',label:'Libero',detail:'Nessuna prenotazione imminente',score:0};if(!current&&next){const d=mins(next.start)-now;if(d<=cfg.soonMin)return{level:d<=Math.max(5,Math.round(cfg.soonMin/2))?'critical':'warning',label:d<=0?'Arrivo atteso':`Tra ${d} min`,detail:`${next.name} · ${next.start}`,score:300-d};return{level:'soon',label:`Prossimo ${next.start}`,detail:`${next.name} · ${next.people} p`,score:80-d}}if(current&&current.status!==SEATED){const late=now-mins(current.start);return{level:late>=cfg.lateMin?'critical':'warning',label:late>=cfg.lateMin?`Atteso da ${late} min`:'Arrivo atteso',detail:`${current.name} · ${current.people} p`,score:500+Math.max(0,late)}}if(current){const duration=Math.max(30,+current.duration||90),base=mins(current.seatedAt||current.start),expected=base+duration;if(next){const releaseBy=mins(next.start)-cfg.turnoverBufferMin,remaining=releaseBy-now,overlap=expected-releaseBy;let level='ok',label=remaining<=0?'Da liberare ora':`Liberare entro ${remaining} min`;if(remaining<=Math.max(10,cfg.turnoverBufferMin*2)||overlap>0)level='critical';else if(remaining<=Math.max(25,cfg.turnoverBufferMin*4))level='warning';return{level,label,detail:overlap>0?`Conflitto stimato +${overlap} min · prossimo ${next.start}`:`Prossimo ${next.start}`,score:700-Math.max(-30,remaining)+(overlap>0?150:0)}}return{level:'occupied',label:'Occupato',detail:`Stimato libero ${String(Math.floor(expected/60)%24).padStart(2,'0')}:${String(expected%60).padStart(2,'0')}`,score:120}}return{level:'free',label:'Libero',detail:'',score:0}}
function roomName(r){return typeof r==='string'?r:String(r?.name||'')}
function hasLayout(tables){return tables.some(t=>Math.abs(+t.x||0)>0||Math.abs(+t.y||0)>0||Math.abs((+t.width||10)-10)>.01||Math.abs((+t.height||10)-10)>.01)}
function mapGeometry(tables){const laidOut=hasLayout(tables);if(!laidOut)return{laidOut:false,maxX:100,maxY:100};let maxX=100,maxY=100;for(const t of tables){maxX=Math.max(maxX,(+t.x||0)+Math.max(4,+t.width||10));maxY=Math.max(maxY,(+t.y||0)+Math.max(4,+t.height||10))}return{laidOut:true,maxX,maxY}}
function combinationMap(combinations=[]){const out=new Map;for(const combo of combinations){for(const id of tableIds(combo.tables)){const list=out.get(String(id))||[];list.push(combo);out.set(String(id),list)}}return out}

export default function SalaLivePage({boot}){
 const navigate=useNavigate()
 const[date,setDate]=useState(localToday()),[board,setBoard]=useState(null),[loading,setLoading]=useState(true),[error,setError]=useState(''),[query,setQuery]=useState(''),[room,setRoom]=useState('all'),[mode,setMode]=useState('map'),[selected,setSelected]=useState(null),[busy,setBusy]=useState(''),[moveMode,setMoveMode]=useState(false),[moveRoom,setMoveRoom]=useState(''),[moveSelection,setMoveSelection]=useState([]),[clockTick,setClockTick]=useState(0),receivedAt=useRef(Date.now()),alive=useRef(true)
 const load=useCallback(async({silent=false}={})=>{if(!silent)setLoading(true);try{const x=await managerApi('getTabletBoard',date);if(!alive.current)return;receivedAt.current=Date.now();setBoard(x);setError('');setSelected(old=>old?(x.bookings||[]).find(b=>String(b.id)===String(old.id))||null:null)}catch(e){if(alive.current)setError(e.message||'Sala Live non disponibile.')}finally{if(alive.current&&!silent)setLoading(false)}},[date])
 useEffect(()=>{alive.current=true;load();const refresh=setInterval(()=>load({silent:true}),15000),tick=setInterval(()=>setClockTick(x=>x+1),1000);const visible=()=>{if(document.visibilityState==='visible')load({silent:true})};document.addEventListener('visibilitychange',visible);return()=>{alive.current=false;clearInterval(refresh);clearInterval(tick);document.removeEventListener('visibilitychange',visible)}},[load])
 const cfg=useMemo(()=>liveConfig(board,boot),[board,boot]),now=useMemo(()=>operationalMinute(board?.serverTimestamp,receivedAt.current),[board?.serverTimestamp,clockTick])
 const allRows=useMemo(()=>((board?.bookings)||[]).filter(r=>!ACTIVE_EXCLUDED.has(r.status)&&!r.released).sort((a,b)=>mins(a.start)-mins(b.start)||String(a.tables).localeCompare(String(b.tables),'it',{numeric:true})),[board])
 const roomRows=useMemo(()=>allRows.filter(r=>room==='all'||r.room===room),[allRows,room])
 const rows=useMemo(()=>roomRows.filter(r=>!query||`${r.name} ${r.phone} ${r.tables} ${r.room}`.toLowerCase().includes(query.toLowerCase())),[roomRows,query])
 const waiting=rows.filter(r=>r.status!==SEATED),seated=rows.filter(r=>r.status===SEATED&&!r.orderTaken),orders=rows.filter(r=>r.status===SEATED&&r.orderTaken),late=waiting.filter(r=>now-mins(r.start)>=cfg.lateMin)
 const rooms=useMemo(()=>{const defs=(board?.roomDefinitions||boot?.settings?.roomDefinitions||[]).filter(r=>r?.enabled!==false);if(defs.length)return defs;return(board?.rooms||boot?.settings?.rooms||[]).map(name=>({name:roomName(name),enabled:true}))},[board,boot])
 const allTables=useMemo(()=>((board?.tables)||[]).filter(t=>t.enabled!==false),[board]),tables=useMemo(()=>allTables.filter(t=>room==='all'||t.room===room),[allTables,room])
 const globalTableState=useMemo(()=>{const m=new Map;for(const t of allTables)m.set(String(t.id),{table:t,current:null,next:null});for(const r of allRows){for(const id of tableIds(r.tables)){const x=m.get(String(id));if(!x)continue;if(r.status===SEATED){x.current=r;continue}const delta=mins(r.start)-now;if(delta<=0&&delta>-Math.max(90,+r.duration||90))x.current=x.current||r;else if(delta>0&&(!x.next||mins(r.start)<mins(x.next.start)))x.next=r}}return[...m.values()].map(x=>({...x,pressure:tablePressure(x,now,cfg)}))},[allTables,allRows,now,cfg])
 const tableState=useMemo(()=>globalTableState.filter(x=>room==='all'||x.table.room===room),[globalTableState,room])
 const stateById=useMemo(()=>new Map(globalTableState.map(x=>[String(x.table.id),x])),[globalTableState]),combosByTable=useMemo(()=>combinationMap(board?.tableCombinations||[]),[board])
 const tablePriorities=useMemo(()=>tableState.filter(x=>['critical','warning'].includes(x.pressure.level)).sort((a,b)=>b.pressure.score-a.pressure.score).slice(0,6),[tableState])
 const criticalTables=tableState.filter(x=>x.pressure.level==='critical').length,turnovers60=tableState.filter(x=>x.next&&mins(x.next.start)-now>0&&mins(x.next.start)-now<=60).length,freeTables=tableState.filter(x=>!x.current).length
 const open=row=>{if(!row)return;setSelected(row);setMoveMode(false);setMoveRoom(row?.room||'');setMoveSelection(tableIds(row?.tables))}
 const action=async(key,work)=>{if(!selected||busy)return;setBusy(key);setError('');try{await work();await load({silent:true});setSelected(null);setMoveMode(false)}catch(e){setError(e.message||'Operazione non completata.')}finally{setBusy('')}}
 const seat=()=>action('seat',()=>managerApi('tabletMarkAccommodated',selected.id,operationalTime(board?.serverTimestamp,receivedAt.current),selected.tables))
 const undo=()=>action('undo',()=>managerApi('tabletUndoAccommodated',selected.id))
 const order=enabled=>action('order',()=>managerApi('tabletMarkOrderTaken',selected.id,enabled,operationalTime(board?.serverTimestamp,receivedAt.current)))
 const release=()=>{if(!window.confirm(`Liberare ${selected?.tables||'il tavolo'} di ${selected?.name||'questo cliente'}? Il tavolo tornerà disponibile in Sala Live.`))return;action('release',()=>managerApi('tabletMarkReleased',selected.id,operationalTime(board?.serverTimestamp,receivedAt.current)))}
 const move=()=>action('move',()=>managerApi('updateBooking',selected.id,{room:moveRoom||selected.room,tables:canonicalTables(moveSelection),expectedUpdatedAt:selected.updatedAt,_operationSource:'sala_live_move'}))
 const toggleMove=id=>setMoveSelection(x=>x.includes(String(id))?x.filter(v=>v!==String(id)):[...x,String(id)])
 const mapRooms=room==='all'?rooms.map(roomName).filter(Boolean):[room]
 const moveComboAllowed=moveSelection.length<=1||(board?.tableCombinations||[]).some(c=>c.room===(moveRoom||selected?.room)&&canonicalTables(tableIds(c.tables))===canonicalTables(moveSelection))
 return <section className="page sala-live-23 sala-live-25" data-testid="manager-sala-live">
  <div className="live-head"><div><div className="eyebrow">Sala operativa · multi-tenant · aggiornamento automatico</div><h1>Sala Live</h1><p>{board?.restaurantName||boot?.settings?.name||'Ristorante'} · Ultimo sync {board?.serverTime||'—'}.</p></div><div className="live-clock"><RadioTower size={18}/><strong>{operationalTime(board?.serverTimestamp,receivedAt.current)}</strong><span>{date===localToday()?'Adesso':date}</span></div></div>
  <div className="live-kpis"><Kpi label="Da accomodare" value={waiting.length}/><Kpi label="In ritardo" value={late.length} danger={late.length>0}/><Kpi label="Tavoli critici" value={criticalTables} danger={criticalTables>0}/><Kpi label="Cambi entro 60 min" value={turnovers60}/><Kpi label="Tavoli liberi" value={freeTables}/></div>
  <article className="panel live-priority-panel"><div className="panel-head"><div><span>Operatività durante il servizio</span><h2>Priorità tavoli</h2></div><AlertTriangle size={17}/></div><div className="live-priority-list">{tablePriorities.map(x=><button key={`${x.table.room}-${x.table.id}`} className={`live-priority ${x.pressure.level}`} onClick={()=>open(x.current||x.next)}><strong>{x.table.label||tableLabel(x.table.id)}</strong><span>{x.pressure.label}</span><small>{x.pressure.detail}</small></button>)}{!tablePriorities.length&&<div className="all-clear compact"><span>✓</span><div><strong>Nessun tavolo critico</strong><small>I prossimi cambi risultano gestibili.</small></div></div>}</div></article>
  <div className="live-toolbar"><input type="date" value={date} onChange={e=>setDate(e.target.value)}/><div className="live-rooms"><button className={room==='all'?'active':''} onClick={()=>setRoom('all')}>Tutte</button>{rooms.map(r=>{const name=roomName(r);return <button key={name} className={room===name?'active':''} onClick={()=>setRoom(name)}>{name}</button>})}</div><label className="live-search"><Search size={14}/><input value={query} onChange={e=>setQuery(e.target.value)} placeholder="Cliente, telefono, tavolo"/></label><div className="live-view-toggle" aria-label="Modalità Sala Live"><button className={mode==='map'?'active':''} onClick={()=>setMode('map')}><LayoutGrid size={14}/> Mappa</button><button className={mode==='list'?'active':''} onClick={()=>setMode('list')}><List size={14}/> Lista</button></div><button className="small-action" onClick={()=>load()} disabled={loading}><RefreshCcw className={loading?'spin':''} size={14}/> Aggiorna</button></div>
  <div className="live-config-hint">Regole tenant: imminente {cfg.soonMin} min · ritardo {cfg.lateMin} min · buffer cambio {cfg.turnoverBufferMin} min</div>
  {error&&<div className="editor-error live-error" role="alert"><AlertTriangle size={15}/><span>{error}</span><button onClick={()=>load()}>Riprova</button></div>}
  {mode==='map'?<div className="live-map-stack">{mapRooms.map(roomNameValue=>{const roomTables=allTables.filter(t=>t.room===roomNameValue),geometry=mapGeometry(roomTables);return <LiveRoomMap key={roomNameValue} room={roomNameValue} tables={roomTables} stateById={stateById} geometry={geometry} combosByTable={combosByTable} query={query} onOpen={open}/>})}{!mapRooms.length&&<article className="panel placeholder"><strong>Nessuna sala configurata</strong><span>Configura almeno una sala per usare la mappa operativa.</span></article>}</div>:<div className="live-layout"><div className="live-columns"><LiveColumn title="Da accomodare" count={waiting.length} rows={waiting} now={now} cfg={cfg} onOpen={open}/><LiveColumn title="Accomodati" count={seated.length} rows={seated} now={now} cfg={cfg} onOpen={open}/><LiveColumn title="Comanda presa" count={orders.length} rows={orders} now={now} cfg={cfg} onOpen={open}/></div><aside className="panel live-floor"><div className="panel-head"><div><span>Tavoli</span><h2>Situazione sala</h2></div></div><div className="live-table-grid">{tableState.map(({table,current,next,pressure})=><button key={`${table.room}-${table.id}`} className={`live-table ${pressure.level}`} onClick={()=>open(current||next)}><strong>{table.label||tableLabel(table.id)}</strong><span>{pressure.label}</span><small>{pressure.detail||`${table.seats||'—'} posti`}</small></button>)}{!tableState.length&&<div className="empty">Nessun tavolo configurato per questa sala.</div>}</div></aside></div>}
  {selected&&<div className="live-sheet-backdrop" onClick={()=>setSelected(null)}><div className="live-sheet" onClick={e=>e.stopPropagation()}><button className="sheet-close" aria-label="Chiudi" onClick={()=>setSelected(null)}><X/></button><div className="eyebrow">{statusLabel(selected,now,cfg)}</div><h2>{selected.name}</h2><div className="sheet-meta"><span><Clock3 size={14}/>{selected.start}</span><span><UsersRound size={14}/>{selected.people} persone</span><span><Armchair size={14}/>{selected.tables||'Senza tavolo'}</span><span>{selected.room||'Sala non assegnata'}</span></div>{selected.notes&&<div className="sheet-notes">{selected.notes}</div>}
   {!moveMode?<div className="sheet-actions">{selected.status!==SEATED?<button className="primary" disabled={!selected.tables||busy} onClick={seat}><CheckCircle2 size={16}/>{busy==='seat'?'Salvataggio…':'Accomoda adesso'}</button>:<><button className="primary" disabled={busy} onClick={()=>order(!selected.orderTaken)}><Utensils size={16}/>{selected.orderTaken?'Ripristina comanda':'Comanda presa'}</button><button disabled={busy} onClick={undo}><Undo2 size={16}/> Riporta da accomodare</button><button className="release-t
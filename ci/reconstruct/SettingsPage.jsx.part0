import React,{useEffect,useMemo,useRef,useState}from'react'
import{Save,Mail,Clock3,UsersRound,Smartphone,Send,RadioTower,BrainCircuit}from'lucide-react'
import{managerApi}from'../lib/api'
import{useUnsavedChanges}from'../lib/useUnsavedChanges'
import{loadWorkspaceValue,removeWorkspaceValue,saveWorkspaceValue}from'../lib/workspaceState'

const truth=v=>v?'TRUE':'FALSE'
export default function SettingsPage({boot,onSaved}){
 const initial=useMemo(()=>boot?.settings||{},[boot])
 const[form,setForm]=useState(()=>{const base={
  times:(initial.times||[]).join(', '),engineStrategy:initial.tableEngine?.strategyProfile||'balanced',engineTurnaround:initial.tableEngine?.turnaroundMin??10,engineHorizon:initial.tableEngine?.planningHorizonMin??180,engineExtraChair:initial.tableEngine?.extraChairPenalty??4,engineReserve:initial.tableEngine?.reservePenalty??18,engineUnion:initial.tableEngine?.unionPenalty??45,engineRoomWeight:initial.tableEngine?.roomPriorityWeight??8,engineLoadWeight:initial.tableEngine?.loadBalanceWeight??6,engineFutureBlock:initial.tableEngine?.futureBlockPenalty??55,engineSingleOption:initial.tableEngine?.singleOptionPenalty??22,engineOptionReduction:initial.tableEngine?.optionReductionPenalty??8,engineRoomPriorities:Object.fromEntries((initial.rooms||[]).map((r,i)=>[r,initial.tableEngine?.roomPriorities?.[r]??Math.max(0,(initial.rooms||[]).length-i)])),durationBands:(initial.durationRules?.bands||[{minPeople:1,maxPeople:2,duration:initial.durationSmall||90},{minPeople:3,maxPeople:4,duration:initial.durationSmall||90},{minPeople:5,maxPeople:8,duration:initial.durationSmall||90},{minPeople:9,maxPeople:99,duration:initial.durationLarge||120}]).map(x=>({...x})),durationOverrides:(initial.durationRules?.overrides||[]).map(x=>({...x})),durationSmall:initial.durationSmall||90,durationLarge:initial.durationLarge||120,maxLarge:initial.maxLargePartiesPerRoomTurn||3,liveBuffer:initial.salaLive?.turnoverBufferMin??10,liveSoon:initial.salaLive?.soonMin??30,liveLate:initial.salaLive?.lateMin??10,
  clientEnabled:!!initial.clientEnabled,clientTitle:initial.clientTitle||'Prenota un tavolo',maxParty:initial.maxParty||20,daysAhead:initial.daysAhead||90,minNoticeHours:initial.minNoticeHours||1,clientClosed:(initial.clientClosedTimes||[]).join(', '),privacyText:initial.privacyText||'',
  emailsEnabled:!!initial.emailsEnabled,emails:[...(initial.emails||['','',''])],requestEmail:initial.requestEmail||'',
  smtpHost:initial.smtp?.host||'smtps.aruba.it',smtpPort:initial.smtp?.port||465,smtpUser:initial.smtp?.username||'',smtpPassword:'',smtpPasswordSet:!!initial.smtp?.passwordSet,smtpEncryption:initial.smtp?.encryption||'ssl',smtpFrom:initial.smtp?.fromAddress||'',smtpFromName:initial.smtp?.fromName||'Ristorante Prenotazioni',capacities:Object.fromEntries(Object.entries(initial.capacities||{}).map(([room,rows])=>[room,Object.fromEntries((rows||[]).map(x=>[x.time,+x.value||0]))])),smallClosed:{MON:(initial.clientSmallClosedSlots?.MON||[]).join(', '),TUE:(initial.clientSmallClosedSlots?.TUE||[]).join(', '),WED:(initial.clientSmallClosedSlots?.WED||[]).join(', '),THU:(initial.clientSmallClosedSlots?.THU||[]).join(', '),FRI:(initial.clientSmallClosedSlots?.FRI||[]).join(', '),SAT:(initial.clientSmallClosedSlots?.SAT||[]).join(', '),SUN:(initial.clientSmallClosedSlots?.SUN||[]).join(', ')},manualEnabled:!!initial.manualEmail?.enabled,manualRecipients:[...(initial.manualEmail?.recipients||['','',''])],manualSubject:initial.manualEmail?.subject||'Nuova prenotazione manuale',manualSender:initial.manualEmail?.senderName||'Manager',clientEmailEnabled:!!initial.clientEmail?.enabled,clientRecipients:[...(initial.clientEmail?.recipients||['','',''])],clientSubject:initial.clientEmail?.subject||'Nuova richiesta dall’app clienti',clientSender:initial.clientEmail?.senderName||'App Clienti'
 };const draft=loadWorkspaceValue('settings-draft',null);return draft&&typeof draft==='object'?{...base,...draft,smtpPassword:''}:base}),[busy,setBusy]=useState(false),[message,setMessage]=useState(''),[error,setError]=useState(''),[durationInsights,setDurationInsights]=useState(null),[durationInsightsError,setDurationInsightsError]=useState('')
 const recoveredDraftRef=useRef(!!loadWorkspaceValue('settings-draft',null)),baselineRef=useRef(JSON.stringify({...form,smtpPassword:''})),dirty=recoveredDraftRef.current||JSON.stringify({...form,smtpPassword:''})!==baselineRef.current||!!form.smtpPassword
 useUnsavedChanges(dirty,'Hai modifiche alle impostazioni non salvate. Vuoi uscire senza salvarle?')
 useEffect(()=>{let active=true;managerApi('getDurationInsights').then(x=>{if(active){setDurationInsights(x);setDurationInsightsError('')}}).catch(e=>{if(active)setDurationInsightsError(e.message||'Statistiche durata non disponibili.')});return()=>{active=false}},[])
 useEffect(()=>{if(!dirty){removeWorkspaceValue('settings-draft');return}const safe={...form,smtpPassword:''};saveWorkspaceValue('settings-draft',safe)},[dirty,form])
 const validation=useMemo(()=>{
  const errors=[],slotRe=/^([01]\d|2[0-3]):[0-5]\d$/,emailRe=/^[^\s@]+@[^\s@]+\.[^\s@]+$/
  const parseSlots=value=>String(value||'').split(',').map(x=>x.trim()).filter(Boolean)
  const times=parseSlots(form.times)
  if(!times.length)errors.push('Inserisci almeno una fascia oraria.')
  if(times.some(x=>!slotRe.test(x)))errors.push('Le fasce devono usare il formato HH:MM.')
  if(new Set(times).size!==times.length)errors.push('Rimuovi le fasce orarie duplicate.')
  const closedGroups=[['Fasce chiuse online',form.clientClosed],...Object.entries(form.smallClosed||{}).map(([day,value])=>[`Blocchi ${day}`,value])]
  for(const[label,value]of closedGroups){const slots=parseSlots(value);if(slots.some(x=>!slotRe.test(x)))errors.push(`${label}: usa il formato HH:MM.`);if(new Set(slots).size!==slots.length)errors.push(`${label}: rimuovi gli orari duplicati.`)}
  if((form.durationBands||[]).length<1||(form.durationBands||[]).some(x=>+x.minPeople<1||+x.maxPeople<+x.minPeople||+x.duration<30||+x.duration>480))errors.push('Controlla le fasce durata: persone valide e durata tra 30 e 480 minuti.')
  if((form.durationOverrides||[]).some(x=>+x.minPeople<1||+x.maxPeople<+x.minPeople||+x.duration<30||+x.duration>480))errors.push('Controlla le eccezioni durata.')
  if(+form.maxLarge<0||+form.maxLarge>20)errors.push('Gruppi grandi max deve essere tra 0 e 20.');if(+form.engineTurnaround<0||+form.engineTurnaround>120)errors.push('Il margine Motore Tavoli deve essere tra 0 e 120 minuti.');if(+form.engineHorizon<30||+form.engineHorizon>720)errors.push('L’orizzonte Motore Tavoli deve essere tra 30 e 720 minuti.')
  if(+form.liveBuffer<0||+form.liveBuffer>120)errors.push('Il buffer cambio tavolo Sala Live deve essere tra 0 e 120 minuti.')
  if(+form.liveSoon<5||+form.liveSoon>180)errors.push('La finestra imminente Sala Live deve essere tra 5 e 180 minuti.')
  if(+form.liveLate<1||+form.liveLate>120)errors.push('La soglia ritardo Sala Live deve essere tra 1 e 120 minuti.')
  if(+form.maxParty<1||+form.maxParty>99)errors.push('Persone max App Clienti deve essere tra 1 e 99.')
  if(+form.daysAhead<1||+form.daysAhead>365)errors.push('Giorni prenotabili deve essere tra 1 e 365.')
  if(+form.minNoticeHours<0||+form.minNoticeHours>168)errors.push('Il preavviso deve essere tra 0 e 168 ore.')
  if(+form.smtpPort<1||+form.smtpPort>65535)errors.push('La porta SMTP deve essere tra 1 e 65535.')
  const emails=[...form.emails,...form.manualRecipients,...form.clientRecipients,form.requestEmail,form.smtpFrom].map(x=>String(x||'').trim()).filter(Boolean)
  if(emails.some(x=>!emailRe.test(x)))errors.push('Controlla il formato degli indirizzi email.')
  for(const[room,slots]of Object.entries(form.capacities||{}))for(const[time,value]of Object.entries(slots||{})){if(!Number.isFinite(+value)||+value<0||+value>1000)errors.push(`Capienza ${room} ${time}: inserisci un valore tra 0 e 1000.`)}
  const mailOn=form.emailsEnabled||form.manualEnabled||form.clientEmailEnabled
  if(mailOn){if(!form.smtpHost.trim()||!form.smtpUser.trim())errors.push('Per le email configura host e username SMTP.');if(!form.smtpPasswordSet&&!form.smtpPassword.trim())errors.push('Inserisci la password SMTP almeno una volta.')}
  return errors
 },[form])
 const set=(k,v)=>setForm(f=>({...f,[k]:v}));const setBand=(i,k,v)=>setForm(f=>({...f,durationBands:f.durationBands.map((x,n)=>n===i?{...x,[k]:+v}:x)}));const addDurationOverride=()=>setForm(f=>({...f,durationOverrides:[...f.durationOverrides,{day:'ALL',room:'*',from:'',to:'',minPeople:1,maxPeople:99,duration:90}]}));const setDurationOverride=(i,k,v)=>setForm(f=>({...f,durationOverrides:f.durationOverrides.map((x,n)=>n===i?{...x,[k]:['minPeople','maxPeople','duration'].includes(k)?+v:v}:x)}));const removeDurationOverride=i=>setForm(f=>({...f,durationOverrides:f.durationOverrides.filter((_,n)=>n!==i)}));const setEmail=(i,v)=>setForm(f=>({...f,emails:f.emails.map((x,n)=>n===i?v:x)}));const setCapacity=(room,time,value)=>setForm(f=>({...f,capacities:{...f.capacities,[room]:{...(f.capacities[room]||{}),[time]:+value||0}}}));const setSmall=(day,v)=>setForm(f=>({...f,smallClosed:{...f.smallClosed,[day]:v}}));const setRec=(kind,i,v)=>setForm(f=>({...f,[kind]:f[kind].map((x,n)=>n===i?v:x)}))
 const save=async()=>{if(validation.length){setError(validation[0]);return}setBusy(true);setError('');setMessage('');try{const payload={ORARI_ATTIVI:form.times,DURATA_1_8:+(form.durationBands.find(x=>+x.minPeople<=4&&+x.maxPeople>=4)?.duration||form.durationBands[0]?.duration||90),DURATA_9_PLUS:+(form.durationBands.find(x=>+x.minPeople<=9&&+x.maxPeople>=9)?.duration||120),BOOKING_DURATION_RULES_JSON:JSON.stringify({version:1,bands:form.durationBands,overrides:form.durationOverrides}),MAX_LARGE_PARTIES_PER_ROOM_TURN:+form.maxLarge,TABLE_ENGINE_STRATEGY_PROFILE:form.engineStrategy,TABLE_ENGINE_ROOM_PRIORITIES_JSON:JSON.stringify(form.engineRoomPriorities),TABLE_ENGINE_MIN_TURNAROUND_MINUTES:+form.engineTurnaround,TABLE_ENGINE_PLANNING_HORIZON_MINUTES:+form.engineHorizon,TABLE_ENGINE_EXTRA_CHAIR_PENALTY:+form.engineExtraChair,TABLE_ENGINE_RESERVE_PENALTY:+form.engineReserve,TABLE_ENGINE_UNION_PENALTY:+form.engineUnion,TABLE_ENGINE_ROOM_PRIORITY_WEIGHT:+form.engineRoomWeight,TABLE_ENGINE_LOAD_BALANCE_WEIGHT:+form.engineLoadWeight,TABLE_ENGINE_BLOCK_FUTURE_BOOKING_PENALTY:+form.engineFutureBlock,TABLE_ENGINE_SINGLE_OPTION_PENALTY:+form.engineSingleOption,TABLE_ENGINE_OPTION_REDUCTION_PENALTY:+form.engineOptionReduction,SALA_LIVE_TURNOVER_BUFFER_MIN:+form.liveBuffer,SALA_LIVE_SOON_MIN:+form.liveSoon,SALA_LIVE_LATE_MIN:+form.liveLate,CLIENT_APP_ENABLED:truth(form.clientEnabled),CLIENT_APP_TITLE:form.clientTitle,CLIENT_MAX_PARTY:+form.maxParty,CLIENT_DAYS_AHEAD:+form.daysAhead,CLIENT_MIN_NOTICE_HOURS:+form.minNoticeHours,CLIENT_CLOSED_TIMES:form.clientClosed,CLIENT_PRIVACY_TEXT:form.privacyText,EMAIL_NOTIFICHE_ATTIVE:truth(form.emailsEnabled),EMAIL_NOTIFICHE_1:form.emails[0]||'',EMAIL_NOTIFICHE_2:form.emails[1]||'',EMAIL_NOTIFICHE_3:form.emails[2]||'',EMAIL_RICHIESTE_CLIENTE:form.requestEmail,SMTP_HOST:form.smtpHost,SMTP_PORT:+form.smtpPort,SMTP_USERNAME:form.smtpUser,SMTP_PASSWORD:form.smtpPassword,SMTP_ENCRYPTION:form.smtpEncryption,SMTP_FROM_ADDRESS:form.smtpFrom,SMTP_FROM_NAME:form.smtpFromName,ROOM_CAPACITIES_JSON:JSON.stringify(form.capacities),CLIENT_SMALL_CLOSED_MON:form.smallClosed.MON,CLIENT_SMALL_CLOSED_TUE:form.smallClosed.TUE,CLIENT_SMALL_CLOSED_WED:form.smallClosed.WED,CLIENT_SMALL_CLOSED_THU:form.smallClosed.THU,CLIENT_SMALL_CLOSED_FRI:form.smallClosed.FRI,CLIENT_SMALL_CLOSED_SAT:form.smallClosed.SAT,CLIENT_SMALL_CLOSED_SUN:form.smallClosed.SUN,MANUAL_EMAIL_ENABLED:truth(form.manualEnabled),MANUAL_EMAIL_1:form.manualRecipients[0]||'',MANUAL_EMAIL_2:form.manualRecipients[1]||'',MANUAL_EMAIL_3:form.manualRecipients[2]||'',MANUAL_EMAIL_SUBJECT:form.manualSubject,MANUAL_EMAIL_SENDER_NAME:form.manualSender,CLIENT_EMAIL_ENABLED:truth(form.clientEmailEnabled),CLIENT_EMAIL_1:form.clientRecipients[0]||'',CLIENT_EMAIL_2:form.clientRecipients[1]||'',CLIENT_EMAIL_3:form.clientRecipients[2]||'',CLIENT_EMAIL_SUBJECT:form.clientSubject,CLIENT_EMAIL_SENDER_NAME:form.clientSender};await managerApi('saveSettings',payload);const next={...form,smtpPassword:'',smtpPasswordSet:form.smtpPasswordSet||!!form.smtpPassword};baselineRef.current=JSON.stringify({...next,smtpPassword:''});recoveredDraftRef.current=false;removeWorkspaceValue('settings-draft');setForm(next);setMessage('Impostazioni salvate.');onSaved&&await onSaved()}catch(e){setError(e.message)}finally{setBusy(false)}}
 const test=async()=>{setBusy(true);setError('');setMessage('');try{await managerApi('sendTestEmail');setMessage('Email di prova inviata.')}catch(e){setError(e.message)}finally{setBusy(false)}}
 return <section className="page settings-v2" data-testid="manager-settings"><div className="page-title"><div><div className="eyebrow">Configurazione</div><h1>Impostazioni</h1><p>Orari, durata tavoli, App Clienti e posta del ristorante.</p>{dirty&&<span className="dirty-badge">Modifiche non salvate</span>}</div><button className="save-top" onClick={save} disabled={busy||validation.length>0}><Save size={16}/> Salva</button></div>{message&&<div className="success" role="status">{message}</div>}{error&&<div className="editor-error" role="alert">{error}</div>}{validation.length>0&&<div className="settings-validation" role="status"><strong>Controlla le impostazioni</strong><span>{validation[0]}{validation.length>1?` · altri ${validation.length-1}`:''}</span></div>}<div className="settings-grid"><Panel icon={Clock3} title="Servizio"><Field label="Fasce attive"><input value={form.times} onChange={e=>set('times',e.target.value)} placeholder="20:00, 20:30, 21:00"/></Field><div className="eyebrow">Durata prevista per numero persone</div><div className="duration-bands">{form.durationBands.map((b,i)=><div className="settings-pair" key={i}><Field label={`${b.minPeople}–${b.maxPeople>=99?'99+':b.maxPeople} persone · minuti`}><input type="number" min="30" max="480" value={b.duration} onChange={e=>setBand(i,'duration',e.target.value)}/></Field></div>)}</div><div className="duration-overrides"><div className="eyebrow">Eccezioni per giorno, sala e fascia</div>{form.durationOverrides.map((r,i)=><div className="duration-rule" key={i}><select value={r.day||'ALL'} onChange={e=>setDurationOverride(i,'day',e.target.value)}><option value="ALL">Tutti i giorni</option>{[['MON','Lun'],['TUE','Mar'],['WED','Mer'],['THU','Gio'],['FRI','Ven'],['SAT','Sab'],['SUN','Dom']].map(([v,l])=><option key={v} value={v}>{l}</option>)}</select><select value={r.room||'*'} onChange={e=>setDurationOverride(i,'room',e.target.value)}><option value="*">Tutte le sale</option>{(initial.rooms||[]).map(room=><option key={room} value={room}>{room}</option>)}</select><input type="time" value={r.from||''} onChange={e=>setDurationOverride(i,'from',e.target.value)}/><input type="time" value={r.to||''} onChange={e=>setDurationOverride(i,'to',e.target.value)}/><input type="number" min="1" max="99" value={r.minPeople} title="Persone min" onChange={e=>setDurationOverride(i,'minPeople',e.target.value)}/><input type="number" min="1" max="99" value={r.maxPeople} title="Persone max" onChange={e=>setDurationOverride(i,'maxPeople',e.target.value)}/><input type="number" min="30" max="480" value={r.duration} title="Durata minuti" onChange={e=>setDurationOverride(i,'duration',e.target.value)}/><button type="button" className="small-action" onClick={()=>removeDurationOverride(i)}>Rimuovi</button></div>)}<button type="button" className="small-action" onClick={addDurationOverride}>+ Aggiungi eccezione durata</button></div><Field label="Gruppi grandi max per sala/fascia"><input type="number" value={form.maxLarge} onChange={e=>set('maxLarge',e.target.value)}/></Field>{durationInsightsError&&<div className="duration-insights-error" role="status">{durationInsightsError}</div>}{durationInsights&&<div className="duration-insights"><div className="eyebrow">Durata reale os